{
  "name": "@gamebeast/sdk",
  "version": "1.0.0",
  "description": "Gamebeast SDK for web apps (browser client) and JavaScript/TypeScript servers.",
  "keywords": [
    "gamebeast",
    "analytics",
    "remote-config",
    "ab-testing",
    "experiments",
    "liveops"
  ],
  "homepage": "https://docs.gamebeast.gg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GamebeastGG/NodeSDK.git"
  },
  "bugs": {
    "url": "https://github.com/GamebeastGG/NodeSDK/issues"
  },
  "author": "Gamebeast, Inc. <support@gamebeast.gg>",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "client": [
        "./dist/client.d.ts"
      ],
      "server": [
        "./dist/server.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "publint && attw --pack . --profile node16 && node scripts/check-client-bundle.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:package"
  },
  "dependencies": {
    "@gamebeast/sdk-contract": "^1.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.24",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
